    "db:reset": "tsx scripts/reset.ts",
    "seed:build": "tsx scripts/build-seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "smoke": "tsx scripts/smoke.ts",
    "users": "tsx scripts/users.ts",
    "nourah:convert": "tsx scripts/convert-nourah.ts",
    "nourah:seed": "tsx scripts/build-seed-nourah.ts",
