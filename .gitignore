# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bases locales PGlite (développement et tests). Le motif est large à dessein :
# chaque vérification crée son propre dossier, PGlite étant mono-processus.
.pglite*/

# Texte extrait des PDF sources, reconstructible
/data/extraits/

# Exports de comptes : journal réel, mots de passe hachés. Jamais publiés.
/data/export/

# Configuration locale de lancement
.claude/
